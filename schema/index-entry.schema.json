{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockheads-club.github.io/mod-sdk/schema/index-entry.schema.json",
  "title": "Blockheads mod index entry (mods/<letter>/<id>.toml in Blockheads-Club/mods)",
  "description": "One file per mod id holding every published version. The TOML file is converted to JSON before validation (TOML dates become YYYY-MM-DD strings). Versions are only appended; a published version may later only gain `yanked = true` and `mirror`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "owners", "repo", "versions"],
  "properties": {
    "id": { "$ref": "mod.schema.json#/$defs/modId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 1024 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "GitHub user names allowed to submit new versions.",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}$" }
    },
    "repo": { "type": "string", "pattern": "^https://" },
    "tags": { "type": "array", "uniqueItems": true, "maxItems": 10, "items": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" } },
    "i18n": {
      "type": "object",
      "minProperties": 1,
      "description": "Optional translations of `name` and `description`, keyed by language code (`tr`, `ru`, `pt-BR` ...). English is the main `name` and `description`; a missing language or field falls back to it.",
      "propertyNames": { "$ref": "mod.schema.json#/$defs/lang", "not": { "const": "en" } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" }
        }
      }
    },
    "draft": {
      "type": "boolean",
      "default": false,
      "description": "Placeholder entry for testing the index tooling (fake URLs). Never published: `bhmod index build` leaves drafts out unless --include-drafts is given."
    },
    "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "sha256", "sides", "api", "permissions", "published"],
      "properties": {
        "version": { "$ref": "mod.schema.json#/$defs/semver" },
        "url": { "type": "string", "pattern": "^https://.*\\.bhmod$", "description": "Where the author publishes the package." },
        "mirror": { "type": "string", "pattern": "^https://", "description": "Copy kept by the index (set by CI)." },
        "sha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the .bhmod file, lowercase hex." },
        "size": { "type": "integer", "minimum": 1, "maximum": 33554432, "description": "Size of the .bhmod in bytes." },
        "sides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["server", "client"] }
        },
        "client-required": { "type": "boolean", "default": false },
        "api": { "type": "string", "minLength": 1 },
        "loader": { "type": "string", "minLength": 1 },
        "depends": { "$ref": "#/$defs/reqMap" },
        "soft-depends": { "$ref": "#/$defs/reqMap" },
        "permissions": { "$ref": "mod.schema.json#/properties/permissions" },
        "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "yanked": { "type": "boolean", "default": false }
      }
    },
    "reqMap": {
      "type": "object",
      "propertyNames": { "$ref": "mod.schema.json#/$defs/modId" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
