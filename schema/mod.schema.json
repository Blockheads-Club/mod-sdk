{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockheads-club.github.io/mod-sdk/schema/mod.schema.json",
  "title": "Blockheads mod manifest (mod.toml), schema 1",
  "description": "The TOML file is converted to JSON before validation. Semantic rules that JSON Schema cannot express (api range matches the host, entry paths match their side, content forces client-required, ...) are checked by `bhmod check` (crate bhmod-manifest).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name", "authors", "license", "api", "sides"],
  "properties": {
    "schema": { "const": 1, "description": "Manifest format version." },
    "id": { "$ref": "#/$defs/modId", "description": "Unique mod id." },
    "version": { "$ref": "#/$defs/semver" },
    "name": { "$ref": "#/$defs/localized64", "required": ["en"], "description": "Display name per language; `en` is required." },
    "description": { "$ref": "#/$defs/localized1024" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "license": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S", "description": "Licence of the mod, chosen by its author (SPDX expression recommended)." },
    "homepage": { "type": "string", "pattern": "^https?://" },
    "api": { "type": "string", "minLength": 1, "description": "semver requirement on blockheads:api, e.g. ^0.1" },
    "loader": { "type": "string", "minLength": 1, "description": "semver requirement on the mod loader / host version" },
    "sides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "boolean", "default": false },
        "client": { "type": "boolean", "default": false },
        "client-required": { "type": "boolean", "description": "Default: same as `client`. Forced true by [content]." }
      },
      "anyOf": [
        { "properties": { "server": { "const": true } }, "required": ["server"] },
        { "properties": { "client": { "const": true } }, "required": ["client"] }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "$ref": "#/$defs/entry", "properties": { "path": { "pattern": "^server/" } } },
        "client": { "$ref": "#/$defs/entry", "properties": { "path": { "pattern": "^client/" } } }
      }
    },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "soft-dependencies": { "$ref": "#/$defs/dependencies" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "world": { "enum": ["none", "read", "write"], "default": "none" },
        "players": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["chat", "teleport", "kick", "ban", "inventory", "health"] }
        },
        "net-http": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$" }
        },
        "channels": { "type": "boolean", "default": false },
        "native": { "type": "boolean", "default": false, "description": "Native hooks or unsandboxed code (JVM, .so). Shown with a red warning." }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "wit"],
            "properties": {
              "name": { "$ref": "#/$defs/modId" },
              "version": { "$ref": "#/$defs/semver" },
              "wit": { "$ref": "#/$defs/path", "pattern": "^wit/.*\\.wit$" },
              "remote": { "type": "boolean", "default": false, "description": "API 0.3.1: the other side (clients for a server mod, the server for a client mod) may call this service over the network." },
              "remote-methods": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
                "description": "Limits `remote` to these methods; empty means every method."
              }
            },
            "if": { "required": ["remote-methods"], "properties": { "remote-methods": { "minItems": 1 } } },
            "then": { "required": ["remote"], "properties": { "remote": { "const": true } } }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "texture"],
            "properties": {
              "key": { "$ref": "#/$defs/contentKey" },
              "texture": { "$ref": "#/$defs/texture" },
              "hardness": { "type": "number", "minimum": 0 },
              "base": { "type": "string", "pattern": "^[a-z0-9-]{3,32}$", "description": "The vanilla block it is a variant of (see the BASE_TILES table)." },
              "drops": { "$ref": "#/$defs/contentKey" },
              "name": { "$ref": "#/$defs/localized64" }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "texture"],
            "properties": {
              "key": { "$ref": "#/$defs/contentKey" },
              "texture": { "$ref": "#/$defs/texture" },
              "name": { "$ref": "#/$defs/localized64" },
              "plural": { "$ref": "#/$defs/localized64", "description": "Plural display name per language; a language without one shows `name`." }
            }
          }
        },
        "cosmetics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "slot", "texture"],
            "properties": {
              "key": { "$ref": "#/$defs/contentKey" },
              "slot": { "enum": ["hat", "shirt", "pants", "shoes", "hair", "weapon"], "description": "Where it is worn or used." },
              "texture": { "$ref": "#/$defs/texture", "description": "PNG laid out like the vanilla texture of the item it re-skins (for shirt: the body)." },
              "texture-arm": { "$ref": "#/$defs/texture", "description": "Shirt only: the arms." },
              "base": { "type": "string", "pattern": "^[a-z0-9-]{3,32}$", "description": "The vanilla item it re-skins (see the BASE_ITEMS table); checked against the slot by `bhmod check`." },
              "name": { "$ref": "#/$defs/localized64" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "modId": { "type": "string", "pattern": "^[a-z0-9_-]{2,40}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$" },
    "localized64": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
      "if": { "minProperties": 1 },
      "then": { "required": ["en"] }
    },
    "localized1024": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lang" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
      "if": { "minProperties": 1 },
      "then": { "required": ["en"] }
    },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[^/\\\\:.\\u0000-\\u001f][^/\\\\:\\u0000-\\u001f]*(/[^/\\\\:.\\u0000-\\u001f][^/\\\\:\\u0000-\\u001f]*)*$",
      "description": "Relative /-separated path; no empty, hidden (leading dot), . or .. components; no \\ or :."
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "path"],
      "properties": {
        "runtime": { "enum": ["wasm", "lua", "jvm"] },
        "path": { "$ref": "#/$defs/path" }
      },
      "allOf": [
        { "if": { "properties": { "runtime": { "const": "wasm" } } }, "then": { "properties": { "path": { "pattern": "\\.wasm$" } } } },
        { "if": { "properties": { "runtime": { "const": "lua" } } }, "then": { "properties": { "path": { "pattern": "\\.luau$" } } } },
        { "if": { "properties": { "runtime": { "const": "jvm" } } }, "then": { "properties": { "path": { "pattern": "\\.jar$" } } } }
      ]
    },
    "dependencies": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/modId" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["version"],
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "side": { "enum": ["server", "client", "both"], "default": "both" }
            }
          }
        ]
      }
    },
    "contentKey": { "type": "string", "pattern": "^[a-z0-9_-]{2,40}:[a-z0-9_-]{1,40}$" },
    "texture": { "$ref": "#/$defs/path", "pattern": "^assets/.*\\.png$" }
  }
}
