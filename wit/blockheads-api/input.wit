package blockheads:api@0.3.4;

/// (0.3.4) Key bindings of client mods. A mod names an action and a default key; the player can rebind it in the
/// loader's settings screen (stored on the device, valid on every server). While the game has focus and no text field
/// is open, the host fires the custom event `<mod-id>:input` with the payload `{"action": text, "pressed": bool}` on
/// key down (once, no auto-repeat) and key up, delivered to the binding mod only. Needs no permission. Server-side
/// hosts return `unsupported`; hosts without a keyboard accept bindings and fire them only for a hardware keyboard.
///
/// Key names: `a`-`z`, `0`-`9`, `f1`-`f12`, `space`, `tab`, `enter`, `backspace`, `insert`, `delete`, `home`,
/// `end`, `page-up`, `page-down`, `up`, `down`, `left`, `right`, `left-shift`, `right-shift`, `left-ctrl`,
/// `right-ctrl`, `left-alt`, `right-alt`, `grave`, `minus`, `equals`, `left-bracket`, `right-bracket`, `backslash`,
/// `semicolon`, `apostrophe`, `comma`, `period`, `slash`, `keypad-0`-`keypad-9`, `mouse-middle`, `mouse-4`,
/// `mouse-5`. `escape` and the game's own keys may be bound but the game keeps its use of them.
interface input {
    use types.{api-error};

    /// Declares (or re-declares) an action. `action` is 1 to 32 characters of `a-z0-9_.-`, at most 16 per mod;
    /// an unknown key name gives `invalid-argument`. The player's own binding, if any, wins over `default-key`.
    bind: func(action: string, default-key: string) -> result<_, api-error>;

    /// Removes an action. False when it did not exist.
    unbind: func(action: string) -> bool;

    /// The key an action is bound to now (the player's choice or the default); `none` when the action does not
    /// exist or the player cleared its key.
    key-of: func(action: string) -> option<string>;
}
