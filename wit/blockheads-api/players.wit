package blockheads:api@0.3.4;

/// Connected players.
interface players {
    use types.{api-error, pos};

    /// What a player may do on this server.
    enum role {
        /// A normal player.
        player,
        /// Listed in the server's moderator list.
        moderator,
        /// Listed in the server's admin list.
        admin,
        /// The server owner / console operator.
        owner,
    }

    /// A handle to one player, owned by the host. It stays valid while the player is connected; after they leave
    /// every method returns `api-error::stale-handle` (or a default value for infallible getters).
    resource player {
        /// The player's stable id as sent by the game client (the vanilla `playerID` string).
        id: func() -> string;
        /// The player's current alias (display name).
        alias: func() -> string;
        /// True while the player is connected.
        is-online: func() -> bool;
        /// The player's role on this server.
        role: func() -> role;
        /// Sends a chat line only this player sees. Needs no permission.
        send-chat: func(text: string) -> result<_, api-error>;
        /// (0.2) The tile of the player's blockhead; `none` when it is not in the world or the player left.
        pos: func() -> option<pos>;
        /// (0.2) The host handle that stands for this player inside values (`{"$h": handle}`, see `types.value`),
        /// for example in service arguments.
        value-handle: func() -> u64;
        /// Disconnects the player with a reason text (shown to modded clients; vanilla clients see the generic
        /// kick message). Needs the `players:kick` permission.
        kick: func(reason: string) -> result<_, api-error>;
    }

    /// Looks up a connected player by id.
    get: func(id: string) -> option<player>;

    /// (0.2) The player behind a host handle from a value; `none` when the handle is stale (the player left).
    from-value-handle: func(handle: u64) -> option<player>;

    /// Looks up a connected player by alias (case-insensitive).
    find-by-alias: func(alias: string) -> option<player>;

    /// All connected (approved) players, in join order.
    online: func() -> list<player>;

    /// Sends a chat line to every player, shown as a server message. Needs the `players:chat` permission.
    broadcast: func(text: string) -> result<_, api-error>;
}
