package blockheads:api@0.3.4;

/// The interfaces every mod may import, on both sides.
world core {
    import types;
    import host;
    import log;
    import players;
    import events;
    import commands;
    import scheduler;
    import storage;
    import services;
    import channels;
    import content;
    import settings;
    import voice;
    import terrain;
}

/// A server mod (`[entry] server` in `mod.toml`). Runs in the dedicated server or the host of a local world.
world server-mod {
    include core;
    export guest;
}

/// A client mod (`[entry] client`). Runs in the game client (PC port or Android loader). It gets the core imports
/// (player-join, player-quit and kicks are server-only, and `players` lists the players the client knows about) and,
/// since 0.3, `ui` for the HUD, toasts and dialogs, and since 0.3.4 `input` for key bindings. Other client interfaces
/// (rendering, assets) come later.
world client-mod {
    include core;
    import ui;
    import input;
    export guest;
}
