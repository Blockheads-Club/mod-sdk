package blockheads:api@0.3.4;

/// Mod UI on the client (IG-HUD, IG-ModUI): HUD widgets, toasts, notices and dialogs. Mods send data, the loader
/// draws it with its own kit: mods cannot restyle it, place widgets freely or take focus away from the game. Needs
/// no permission, and players can hide any mod's widgets. Server-side hosts and clients without a UI return
/// `api-error::unsupported`. Added in 0.3.
///
/// Dialog results arrive as a custom event named `<mod-id>:ui-action` (subscribe with `events.subscribe-custom`),
/// delivered to the mod that opened the dialog only; the payload is a `types.value` map
/// `{"dialog": u32, "button": u32, "text": string or null}` (`button` counts from 0, `null` text when the dialog
/// has no field). Closing the dialog from the loader side (back, the game leaving the world) is `button` 4294967295.
///
/// (0.3.4) Overhead icons, on-screen buttons and the settings screen. Button input arrives as the custom event
/// `<mod-id>:ui-button` with the payload `{"id": text, "action": "press" | "release" | "long-press"}`, delivered to
/// the mod that owns the button only. When the player picks a blockhead (middle click on PC, 500 ms long press on Android), every client mod gets the custom
/// event `<its-mod-id>:ui-pick` with `{"player": id}` (for example to open a per-player volume dialog).
interface ui {
    use types.{api-error};
    use players.{player};

    /// Where a HUD widget goes. The loader stacks the widgets of a slot, keeps the game's own HUD and the screen
    /// cutout clear and hides what does not fit.
    enum slot {
        /// Under the game's HUD, top left.
        top-left,
        /// Top right.
        top-right,
    }

    /// What a HUD widget looks like.
    enum widget-kind {
        /// One line of text (with an optional icon).
        text,
        /// An icon and a number: `text` holds the number.
        counter,
        /// A small panel: `title` and up to four lines of `text` (split on newlines).
        panel,
    }

    /// One HUD widget. Updating a widget with the same id replaces it.
    record widget {
        slot: slot,
        kind: widget-kind,
        /// A kit icon name: `coin`, `heart`, `info`, `warn`, `check`, `cross`, `bell` or `clock` (more are added
        /// over time). Unknown names draw no icon.
        icon: option<string>,
        /// The panel title (ignored by the other kinds).
        title: option<string>,
        /// The text, at most 256 bytes.
        text: string,
    }

    /// Shows or updates a widget. `id` is 1 to 32 characters of `a-z0-9_.-`, unique within the mod; a mod has up to
    /// 16 widgets.
    set-widget: func(id: string, widget: widget) -> result<_, api-error>;

    /// Removes a widget. Returns false if it did not exist.
    remove-widget: func(id: string) -> bool;

    /// How a notice looks.
    enum notice-level {
        info,
        warning,
        success,
        error,
    }

    /// A short message that stacks bottom right (at most three visible, about four seconds each). `text` is at most
    /// 200 bytes.
    toast: func(text: string) -> result<_, api-error>;

    /// A notice in the top centre, one at a time (a new one replaces the last). `text` is at most 200 bytes.
    notice: func(text: string, level: notice-level) -> result<_, api-error>;

    /// How a dialog button looks.
    enum button-kind {
        primary,
        secondary,
        danger,
    }

    /// One dialog button.
    record dialog-button {
        /// At most 24 bytes.
        label: string,
        kind: button-kind,
    }

    /// The single text field of a dialog.
    record field {
        placeholder: string,
        initial: string,
        /// At most 200.
        max-length: u32,
    }

    /// A dialog: title, text, an optional field and one to three buttons (four since 0.3.4).
    record dialog {
        /// At most 64 bytes.
        title: string,
        /// At most 512 bytes.
        text: string,
        field: option<field>,
        buttons: list<dialog-button>,
    }

    /// Opens a dialog (one at a time per mod) and returns its id. The answer comes as a `<mod-id>:ui-action` event.
    show-dialog: func(dialog: dialog) -> result<u32, api-error>;

    /// Closes a dialog of the mod without an answer. Returns false if it was not open.
    close-dialog: func(id: u32) -> bool;

    /// (0.3.4) An icon drawn above a blockhead.
    enum overhead-icon {
        /// Talking (animated).
        speaking,
        /// The player has no voice chat (crossed headphones).
        no-voice,
        /// The player muted their microphone.
        self-mute,
        /// The player hears nobody.
        deafen,
        /// An admin muted the player.
        admin-mute,
    }

    /// (0.3.4) Shows `icon` above a player's blockhead (one icon per player and mod; a new one replaces it). The
    /// loader hides voice icons the server's admin turned off (`voice.icons`).
    set-overhead: func(who: borrow<player>, icon: overhead-icon) -> result<_, api-error>;

    /// (0.3.4) Removes the mod's icon from a player. False when there was none.
    clear-overhead: func(who: borrow<player>) -> bool;

    /// (0.3.4) A round on-screen button (touch screens; the PC draws it too and clicks work). The player can drag
    /// it; the loader stores where it was dropped on the device, per mod and button id, and that position wins over
    /// `x` / `y`. Touch down fires `press`, holding it 500 ms without moving fires `long-press` (the press stays
    /// down), touch up fires `release`; moving more than a few points turns the touch into a drag (with a `release`
    /// first if `press` fired).
    record button {
        /// A kit icon name (`mic`, `mic-off`, `headphones`, `info`, ...); unknown names draw no icon.
        icon: string,
        /// A short label under the icon, at most 24 bytes.
        label: option<string>,
        /// Default position of the centre as a fraction of the screen width, 0.0 ..= 1.0.
        x: f32,
        /// Default position of the centre as a fraction of the screen height from the top, 0.0 ..= 1.0.
        y: f32,
        /// Diameter in density-independent points, 32 ..= 160.
        size: u16,
        /// Opacity in percent, 10 ..= 100.
        opacity: u8,
    }

    /// (0.3.4) Shows or updates a button. `id` follows the widget id rules; a mod has up to 4 buttons.
    set-button: func(id: string, button: button) -> result<_, api-error>;

    /// (0.3.4) Removes a button. False if it did not exist.
    remove-button: func(id: string) -> bool;

    /// (0.3.4) Opens the loader's settings screen for mod `mod-id` (any loaded mod with settings or key bindings):
    /// its `scope = "client"` settings (stored on this device), its key bindings and, for an admin of a server that
    /// sent the mod's schema (0xBC `SETTINGS_SCHEMA`), its server settings. `invalid-argument` for an unknown mod.
    open-settings: func(mod-id: string) -> result<_, api-error>;

    /// (0.3.4) True when the device has a touch screen (draw on-screen buttons, expect taps instead of keys).
    has-touch: func() -> bool;
}
