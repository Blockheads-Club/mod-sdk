package blockheads:api@0.3.4;

/// (0.3.4) Terrain queries (named `terrain` because `world` is a WIT keyword). Needs no permission.
interface terrain {
    use types.{api-error};

    /// The number of solid tiles on the line from tile `(x1, y1)` to tile `(x2, y2)` (Bresenham, both end tiles
    /// excluded), for muffling voice through walls. `x` wraps around the world width, and the line takes the short way
    /// around. Tiles that are not loaded count as not solid. Lines are cut after 256 tiles. Server only: clients return
    /// `unsupported`.
    solid-count: func(x1: s32, y1: s32, x2: s32, y2: s32) -> result<u32, api-error>;

    /// The world width in tiles (`x` wraps around it), for distances and stereo pan the short way round; `none` when
    /// the host does not know it (before the world loaded, on clients that do not track it).
    world-width: func() -> option<s32>;
}
